# Icons are content-addressed by champion/item/augment id and only change when
# Riot ships new art, so they can be cached hard. The data files change on each
# rebuild, so they revalidate.
/img/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=300, must-revalidate

# index.html must never be cached: it names the content-hashed bundles, so a
# stale copy points at assets that no longer exist. The bundles it references
# are immutable, so revalidating the HTML on every visit costs one cheap 304.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
